# ==============================================================================
# PLANTILLA DE VARIABLES DE ENTORNO (.env.example)
# Laboratorio de Gestión de Riesgos - Seguridad y Control de Secretos (SEG-01)
# ==============================================================================
# INSTRUCCIONES:
# 1. NO introduzcas credenciales reales en este archivo ni lo subas a Git.
# 2. Custodia los valores reales en tu bóveda segura de Bitwarden.
# 3. Para ejecución local: copia este archivo a '.env.local' y asigna valores reales.
# 4. Para despliegues en Vercel: configura estas variables en Settings -> Environment Variables.
# ==============================================================================

# Entorno de ejecución (development, preview, production) - Requisito SEG-06
NODE_ENV=development

# Clave secreta para firma de cookies de sesión / autorización en servidor (SEG-02, SEG-03)
# Finalidad: Validar solicitudes de escritura y prevenir modificaciones no autorizadas.
# Formato sugerido: Cadena aleatoria de 32+ caracteres (p. ej. generada por Bitwarden Password Generator).
# Lugar de uso: Solo servidor (Next.js Server Actions / API routes).
SESSION_SECRET=tu_secreto_generado_en_bitwarden_min_32_caracteres

# Token o credencial administrativa para autorización de operaciones críticas (SEG-03)
# Finalidad: Proteger endpoints y mutaciones de datos en servidor.
# Formato sugerido: Token seguro o hash custodiado en Bitwarden.
# Lugar de uso: Solo servidor.
ADMIN_API_KEY=tu_token_administrativo_custodiado_en_bitwarden

# Persistencia con Vercel KV (Redis) - Requisito SEG-04 (Mínimo Privilegio)
# Finalidad: Persistencia y recuperación de riesgos registrados tras recargar la página.
# Variables estándar inyectadas automáticamente por Vercel al vincular Storage KV:
KV_URL=redis://default:token_bitwarden@endpoint:6379
KV_REST_API_URL=https://endpoint.upstash.io
KV_REST_API_TOKEN=token_escritura_bitwarden
# Para operaciones de solo lectura en cliente o servicios no privilegiados (Least Privilege):
KV_REST_API_READ_ONLY_TOKEN=token_lectura_bitwarden

# Prefijo público para cliente (si fuera estrictamente necesario exponer alguna variable)
# REGLA SEG-02: ¡NUNCA colocar credenciales bajo el prefijo NEXT_PUBLIC_!
# NEXT_PUBLIC_APP_ENV=preview

