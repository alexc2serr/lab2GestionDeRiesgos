# ==============================================================================
# PLANTILLA DE VARIABLES DE ENTORNO (.env.example)
# Laboratorio 2 - Securización de la Aplicación de Gestión de Riesgos (SEG-01 / SEG-04)
# ==============================================================================
# INSTRUCCIONES:
# 1. NUNCA introduzcas credenciales reales en este archivo ni las subas a Git.
# 2. Custodia los valores reales exclusivamente en tu bóveda personal de Bitwarden.
# 3. Para ejecución local: copia este archivo a '.env.local' (ignorado por Git).
# 4. Para despliegues en Vercel: añade las variables en Settings -> Environment Variables.
# ==============================================================================

# Entorno de ejecución (development, preview, production) - Requisito SEG-06
NODE_ENV=development

# ------------------------------------------------------------------------------
# 1. BASE DE DATOS POSTGRESQL / NEON (SEG-04 / Mínimo Privilegio)
# ------------------------------------------------------------------------------
# DATABASE_URL (Cuenta de la aplicación):
# - Finalidad: Conexión en tiempo de ejecución para listar, crear y modificar riesgos.
# - Nivel de privilegio: Mínimo necesario (rol 'app_riesgos'). Solo SELECT, INSERT, UPDATE, DELETE.
# - Restricción estricta: NO tiene permisos de CREATE TABLE, DROP TABLE ni ALTER TABLE.
# - Lugar de uso: Servidor en local y en Vercel (Preview).
DATABASE_URL=postgresql://app_riesgos:PASSWORD_BITWARDEN@ep-ejemplo.eu-central-1.aws.neon.tech/neondb?sslmode=require

# DATABASE_URL_ADMIN (Cuenta de administración para migraciones):
# - Finalidad: Ejecutar scripts DDL de esquema (db/01_crear_tabla_riesgos.sql) mediante 'npm run migrate'.
# - Nivel de privilegio: Administrador del esquema (rol 'admin_riesgos').
# - Restricción estricta: Solo se utiliza en LOCAL por el equipo de desarrollo para migraciones.
# - NUNCA debe configurarse como cadena de conexión principal de la aplicación web en producción.
DATABASE_URL_ADMIN=postgresql://admin_riesgos:PASSWORD_BITWARDEN@ep-ejemplo.eu-central-1.aws.neon.tech/neondb?sslmode=require

# ------------------------------------------------------------------------------
# 2. AUTORIZACIÓN Y SESIÓN DEL GESTOR (SEG-02, SEG-03)
# ------------------------------------------------------------------------------
# SESSION_SECRET:
# - Finalidad: Firma criptográfica de la cookie de sesión del perfil 'gestor' (HttpOnly, Secure, SameSite).
# - Generación: Cadena pseudoaleatoria de 32+ caracteres generada en Bitwarden.
# - Lugar de uso: Exclusivamente en servidor (Next.js API routes).
SESSION_SECRET=secreto_firma_sesion_generado_en_bitwarden_min_32_chars

# GESTOR_PASSWORD_HASH:
# - Finalidad: Hash del perfil único 'gestor' para autenticación. La contraseña nunca se guarda en claro.
# - Formato: Hash seguro PBKDF2/Argon2.
GESTOR_PASSWORD_HASH=hash_sha256_o_argon2_custodiado_en_bitwarden

# ADMIN_API_KEY (Compatibilidad y autorización API directa):
# - Finalidad: Token administrativo para autorización de mutaciones en backend.
ADMIN_API_KEY=token_administrativo_custodiado_en_bitwarden
